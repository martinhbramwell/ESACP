# /etc/wireguard/wg0.conf — managed by Ansible (wireguard role)
# WireGuard interface for {{ inventory_hostname }} ({{ wg_role }})

[Interface]
Address    = {{ wg_ip }}/24
PrivateKey = {{ wg_host_key.private_key }}
{% if wg_role == 'hub' %}
ListenPort = {{ wg_port }}
{% endif %}

{% if wg_role == 'hub' %}
# ── Peer: controller ({{ wg_keys.controller.public_key }}) ─────────────────
[Peer]
PublicKey           = {{ wg_keys.controller.public_key }}
PresharedKey        = {{ wg_keys.preshared_keys.controller_saconsole }}
AllowedIPs          = 10.10.0.2/32
# No Endpoint — controller initiates the connection to the hub.

# ── Peer: target1 ({{ wg_keys.target1.public_key }}) ──────────────────────
[Peer]
PublicKey           = {{ wg_keys.target1.public_key }}
PresharedKey        = {{ wg_keys.preshared_keys.target1_saconsole }}
AllowedIPs          = 10.10.0.3/32
# No Endpoint — target1 initiates the connection to the hub.

{% elif inventory_hostname == 'target1' %}
# ── Peer: saconsole hub ────────────────────────────────────────────────────
[Peer]
PublicKey           = {{ wg_keys.saconsole.public_key }}
PresharedKey        = {{ wg_keys.preshared_keys.target1_saconsole }}
AllowedIPs          = 10.10.0.0/24
Endpoint            = 192.168.122.10:{{ wg_port }}
PersistentKeepalive = 25

{% else %}
# ── Peer: saconsole hub (controller spoke) ─────────────────────────────────
[Peer]
PublicKey           = {{ wg_keys.saconsole.public_key }}
PresharedKey        = {{ wg_keys.preshared_keys.controller_saconsole }}
AllowedIPs          = 10.10.0.0/24
Endpoint            = 192.168.122.10:{{ wg_port }}
PersistentKeepalive = 25

{% endif %}
