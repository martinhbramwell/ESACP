# /etc/wireguard/wg0.conf — managed by Ansible (wireguard role)
# WireGuard interface for {{ inventory_hostname }} ({{ wg_role }})

[Interface]
Address    = {{ wg_ip }}/24
PrivateKey = {{ wg_host_key.private_key }}
{% if wg_role == 'hub' %}
ListenPort = {{ wg_port }}
{% set _spoke_hosts = (groups['targets'] | default([])) + (groups['controller'] | default([])) %}
{% for host in _spoke_hosts %}
{% set _key = 'controller' if host == 'localhost' else host %}
# ── Peer: {{ host }} ───────────────────────────────────────────────────────
[Peer]
PublicKey           = {{ wg_keys[_key].public_key }}
PresharedKey        = {{ wg_keys.preshared_keys[_key + '_saconsole'] }}
AllowedIPs          = {{ hostvars[host]['wg_ip'] }}/32
# No Endpoint — {{ host }} initiates the connection to the hub.

{% endfor %}
{% else %}
{% set _key = 'controller' if inventory_hostname in ['controller', 'localhost'] else inventory_hostname %}
# ── Peer: saconsole hub ────────────────────────────────────────────────────
[Peer]
PublicKey           = {{ wg_keys.saconsole.public_key }}
PresharedKey        = {{ wg_keys.preshared_keys[_key + '_saconsole'] }}
AllowedIPs          = 10.10.0.0/24
Endpoint            = {{ wg_hub_endpoint }}:{{ wg_port }}
PersistentKeepalive = 25

{% endif %}
