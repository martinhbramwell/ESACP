# {{ nginx_ui_deploy_dir }}/.env — nginx-ui configuration
# Generated by Ansible — do not edit directly.
# Secrets (nginx_ui_admin_password, nginx_ui_node_secret, nginx_ui_jwt_secret)
# should be overridden in ansible/group_vars/all.sops.yml.
TZ={{ system_timezone }}
NGINX_UI_NODE_SKIP_INSTALLATION=true
NGINX_UI_PREDEFINED_USER_NAME={{ nginx_ui_admin_user }}
NGINX_UI_PREDEFINED_USER_PASSWORD={{ nginx_ui_admin_password }}
NGINX_UI_NODE_SECRET={{ nginx_ui_node_secret }}
NGINX_UI_APP_JWT_SECRET={{ nginx_ui_jwt_secret }}
NGINX_UI_SERVER_PORT=9000
