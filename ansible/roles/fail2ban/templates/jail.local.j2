# ESACP Fail2ban Configuration
# Managed by Ansible - changes will be overwritten

[DEFAULT]
# Ban settings
bantime  = {{ fail2ban_bantime | default(3600) }}
findtime = {{ fail2ban_findtime | default(600) }}
maxretry = {{ fail2ban_maxretry | default(5) }}

# Email notifications (disabled by default)
destemail = root@localhost
sendername = Fail2ban
mta = sendmail

# Actions
banaction = ufw
action = %(action_)s

[sshd]
enabled = true
port = {{ ssh_port | default(22) }}
filter = sshd
logpath = /var/log/auth.log
maxretry = {{ fail2ban_maxretry | default(5) }}
bantime = {{ fail2ban_bantime | default(3600) }}
findtime = {{ fail2ban_findtime | default(600) }}

# [sshd-ddos] removed: filter was dropped in fail2ban 0.10+
# DDoS protection is handled by sshd MaxAuthTries and UFW rate limiting

[nginx-http-auth]
enabled = false  # Enable when Nginx is configured
port = http,https
filter = nginx-http-auth
logpath = /var/log/nginx/error.log
maxretry = 5

[nginx-limit-req]
enabled = false  # Enable when Nginx is configured
port = http,https
filter = nginx-limit-req
logpath = /var/log/nginx/error.log
maxretry = 10
