{
  "uid": "mariadb",
  "title": "MariaDB Overview",
  "description": "MariaDB metrics via mysqld_exporter — ESACP lab",
  "tags": ["mariadb", "mysql", "database"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(mysql_up, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(mysql_up{job=~\"$job\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "MariaDB Up",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mysql_up{job=~\"$job\", host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Queries / sec",
      "type": "timeseries",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries{job=~\"$job\", host=~\"$host\"}[2m])",
          "legendFormat": "{{host}} queries/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 3,
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected{job=~\"$job\", host=~\"$host\"}",
          "legendFormat": "{{host}} connected"
        },
        {
          "expr": "mysql_global_status_max_used_connections{job=~\"$job\", host=~\"$host\"}",
          "legendFormat": "{{host}} max used"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 4,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "x": 0, "y": 4, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mysql_global_status_uptime{job=~\"$job\", host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 5,
      "title": "Network Throughput",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_bytes_received{job=~\"$job\", host=~\"$host\"}[2m])",
          "legendFormat": "{{host}} received"
        },
        {
          "expr": "rate(mysql_global_status_bytes_sent{job=~\"$job\", host=~\"$host\"}[2m])",
          "legendFormat": "{{host}} sent"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 6,
      "title": "InnoDB Buffer Pool",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_innodb_buffer_pool_reads{job=~\"$job\", host=~\"$host\"}[2m])",
          "legendFormat": "{{host}} disk reads"
        },
        {
          "expr": "rate(mysql_global_status_innodb_buffer_pool_read_requests{job=~\"$job\", host=~\"$host\"}[2m])",
          "legendFormat": "{{host}} read requests"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 7,
      "title": "Slow Queries / sec",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_slow_queries{job=~\"$job\", host=~\"$host\"}[5m])",
          "legendFormat": "{{host}} slow queries/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 0.1, "color": "yellow" }, { "value": 1, "color": "red" }] },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 8,
      "title": "Table Locks Waited / sec",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_table_locks_waited{job=~\"$job\", host=~\"$host\"}[2m])",
          "legendFormat": "{{host}} locks waited/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      }
    }
  ]
}
