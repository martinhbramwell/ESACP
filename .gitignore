# Node.js
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# Ansible
*.retry
.ansible/

# Secrets (SOPS encrypted files are tracked, but never plain)
*.secret
*.key
!*.sops.yml
*_decrypted.*

# Age keys (NEVER commit)
keys.txt
age-key.txt

# GPG
*.gpg
*.asc
!*.gpg.enc

# VirtualBox
*.vdi
*.vmdk
*.vbox-prev

# Logs
*.log
logs/
# Migration proof ledger — durable receipts, committed by design (MIGRATION_PLAN.md
# proof method). Without this negation the global *.log ignore silently drops them.
!internal_docs/migration_proofs/*.log

# OS
.DS_Store
Thumbs.db
.directory

# Claude Code — ignore everything except the project-scoped settings, hooks,
# and agents that should ship with the repo.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
!.claude/agents/
!.claude/agents/**

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace

# Temporary
tmp/
temp/
*.tmp

# Certificates (unless specifically tracked)
*.pem
*.crt
*.csr
!selfsigned.crt

# Generated files
internal_docs/diagrams/*.mmd
internal_docs/diagrams/*.svg
internal_docs/diagrams/*.png

# Terraform state (future stages)
*.tfstate
*.tfstate.*
.terraform/

# Local overrides
local_settings.yml
override.yml

# Per-controller signal — operator-touched to trigger Cloudflare MCP token
# refresh on next Cld.sh launch. One-shot: consumed by Cld.sh on success.
.needs-cf-mcp

# Backup files
*.bak
*.backup

# Windows NTFS alternate data streams (created when copying files from Windows)
*:Zone.Identifier

# Binary archives (install from upstream, don't bundle)
*.tar.gz
*.tgz
*.tar
*.zip
*.deb

# Golden-backup archive — pre-refactor fallbacks kept locally, never tracked
# (B03/B06 canonicals are the tracked .tgz files in the parent dir; archive/
# holds displaced prior generations)
platforms/kvm/golden_backups/archive/

# Session/scratch files
dialog*.txt
DIALOG

# Playwright / test runner output
test-results/

# ISOs — never track (seed ISOs, installer ISOs, symlinks to /var/lib/libvirt/images/)
*.iso
# Disk images — never track (covers accidental blank/space-named files that bypass *.iso)
*.img
*.qcow2
*.vmdk
*.vhd
*.raw

# Obsolete/superseded guides
old_*.md

# Scratch ideas (not for repo)
internal_docs/Ideas/
