# Node.js
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# Ansible
*.retry
.ansible/

# Secrets (SOPS encrypted files are tracked, but never plain)
*.secret
*.key
!*.sops.yml
*_decrypted.*

# Age keys (NEVER commit)
keys.txt
age-key.txt

# GPG
*.gpg
*.asc
!*.gpg.enc

# VirtualBox
*.vdi
*.vmdk
*.vbox-prev

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
.directory

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace

# Temporary
tmp/
temp/
*.tmp

# Certificates (unless specifically tracked)
*.pem
*.crt
*.csr
!selfsigned.crt

# Generated files
docs/diagrams/*.mmd
docs/diagrams/*.svg
docs/diagrams/*.png

# Terraform state (future stages)
*.tfstate
*.tfstate.*
.terraform/

# Local overrides
local_settings.yml
override.yml

# Backup files
*.bak
*.backup

# Windows NTFS alternate data streams (created when copying files from Windows)
*:Zone.Identifier

# Binary archives (install from upstream, don't bundle)
*.tar.gz
*.zip
*.deb

# Session/scratch files
dialog*.txt
DIALOG

# ISOs — never track (seed ISOs, installer ISOs, symlinks to /var/lib/libvirt/images/)
*.iso
# Disk images — never track (covers accidental blank/space-named files that bypass *.iso)
*.img
*.qcow2
*.vmdk
*.vhd
*.raw

# Obsolete/superseded guides
old_*.md
