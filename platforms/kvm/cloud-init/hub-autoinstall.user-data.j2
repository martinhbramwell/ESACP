#cloud-config
autoinstall:
  version: 1

  identity:
    hostname: {{ hostname }}
    username: {{ vm_user }}
    # Password login disabled — SSH key only.
    # A hashed placeholder is required by the schema even when allow-pw: false.
    password: "!"

  ssh:
    install-server: true
    authorized-keys:
      - "{{ controller_pubkey }}"
    allow-pw: false

  network:
    version: 2
    ethernets:
      enp1s0:
        addresses:
          - {{ virbr0_ip }}/24
        routes:
          - to: default
            via: {{ gateway }}
        nameservers:
          addresses:
            - 8.8.8.8
            - 1.1.1.1

  packages:
    - wireguard
    - wireguard-tools
    - openssh-server
    - curl
    - wget
    - git
    - python3
    - python3-pip
    - docker.io          # Ansible replaces this with official Docker CE post-install
    - cloud-image-utils  # provides cloud-localds

  storage:
    layout:
      name: direct

  locale: en_US.UTF-8
  timezone: America/New_York

  user-data:
    # Run on first boot after install
    runcmd:
      - echo "{{ vm_user }} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/{{ vm_user }}
      - chmod 440 /etc/sudoers.d/{{ vm_user }}
      - systemctl enable --now docker
      - usermod -aG docker {{ vm_user }}
