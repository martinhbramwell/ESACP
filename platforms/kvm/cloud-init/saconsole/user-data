#cloud-config
autoinstall:
  version: 1

  identity:
    hostname: saconsole
    username: you
    # Password login disabled — SSH key only.
    # A hashed placeholder is required by the schema even when allow-pw: false.
    password: "!"

  ssh:
    install-server: true
    authorized-keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDiKmu/uI7vZZ/GdmO9MhrRlzOhHne8gIK24ZFrmmpiH ${USER}@${HOSTNAME}"
    allow-pw: false

  network:
    version: 2
    ethernets:
      enp1s0:
        addresses:
          - 192.168.122.10/24
        routes:
          - to: default
            via: 192.168.122.1
        nameservers:
          addresses:
            - 8.8.8.8
            - 1.1.1.1

  packages:
    - wireguard
    - wireguard-tools
    - openssh-server
    - curl
    - wget
    - git
    - python3
    - python3-pip
    - docker.io          # Ansible replaces this with official Docker CE post-install
    - cloud-image-utils  # provides cloud-localds

  storage:
    layout:
      name: direct

  locale: en_US.UTF-8
  timezone: America/New_York

  user-data:
    # Run on first boot after install
    runcmd:
      - echo "you ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/you
      - chmod 440 /etc/sudoers.d/you
      - systemctl enable --now docker
      - usermod -aG docker you
