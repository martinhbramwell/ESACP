#cloud-config
autoinstall:
  version: 1

  identity:
    hostname: packer-build
    username: you
    password: "!"

  ssh:
    install-server: true
    authorized-keys:
      - "${CONTROLLER_PUBKEY}"
    allow-pw: false

  network:
    version: 2
    ethernets:
      enp1s0:
        addresses:
          - 192.168.122.20/24
        routes:
          - to: default
            via: 192.168.122.1
        nameservers:
          addresses:
            - 8.8.8.8
            - 1.1.1.1

  packages:
    - openssh-server
    - curl
    - wget
    - git
    - python3

  storage:
    layout:
      name: direct

  locale: en_US.UTF-8
  timezone: America/New_York

  # Passwordless sudo for the build user, written into the target at INSTALL time
  # (not on first boot). On 24.04 the guest boots fast enough that sshd — and the
  # Packer provisioner's `sudo … bash` — connect before a first-boot `runcmd` would
  # have created /etc/sudoers.d/you, so sudo demanded a password (the account
  # password is locked "!"). late-commands run before first boot, so the NOPASSWD
  # rule is guaranteed present when Packer connects. Same resulting file on every
  # major (v13 image content unchanged); the mechanism is just race-free. (#643)
  late-commands:
    - curtin in-target --target=/target -- bash -c "echo 'you ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/you"
    - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/you
