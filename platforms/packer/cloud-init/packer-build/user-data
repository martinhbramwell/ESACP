#cloud-config
autoinstall:
  version: 1

  identity:
    hostname: packer-build
    username: you
    password: "!"

  ssh:
    install-server: true
    authorized-keys:
      - "${CONTROLLER_PUBKEY}"
    allow-pw: false

  network:
    version: 2
    ethernets:
      enp1s0:
        addresses:
          - 192.168.122.20/24
        routes:
          - to: default
            via: 192.168.122.1
        nameservers:
          addresses:
            - 8.8.8.8
            - 1.1.1.1

  packages:
    - openssh-server
    - curl
    - wget
    - git
    - python3

  storage:
    layout:
      name: direct

  locale: en_US.UTF-8
  timezone: America/New_York

  user-data:
    runcmd:
      - echo "you ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/you
      - chmod 440 /etc/sudoers.d/you
